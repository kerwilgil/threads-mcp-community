# Copy this file to .env ONLY for local experiments. The launchers in this repository do not read .env;
# they read the encryption key from ~/.config/threads-mcp/encryption.key (see README.md).
# Never commit a real .env file.

# Fernet key that encrypts the local token store. Generate it with: threads-mcp-auth keygen
TOKEN_ENCRYPTION_KEY=

# Meta app credentials. Only needed while authorizing or reconnecting the account (threads-mcp-auth).
# They are not used by the MCP tools during normal operation.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# Optional runtime overrides (defaults shown). Leave empty to use the XDG locations.
THREADS_API_BASE=https://graph.threads.net/v1.0
THREADS_TOKEN_STORE=
THREADS_LEDGER_PATH=
THREADS_OAUTH_STATE_PATH=
THREADS_REQUEST_TIMEOUT=15

# Publication gate (gate/threads_publication_gate.py). Optional.
# THREADS_GATE_REGISTRY=          # default: ~/.config/threads-mcp/approved-publications.json
# THREADS_GATE_PYTHON=python3     # Python 3.11+ used by the supervisor and the gate
